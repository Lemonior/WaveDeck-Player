<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WaveDeck</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\MusicPlayer\Localization\pt-BR.json" LogicalName="WaveDeck.Localization.pt-BR.json" />
    <Compile Include="..\MusicPlayer\Services\AppReleaseClient.cs;..\MusicPlayer\Services\AppUpdates.cs;..\MusicPlayer\Services\Update*.cs;..\MusicPlayer\Services\PlaybackLookahead.cs" Link="Shared\Services\%(Filename)%(Extension)" />
    <Compile Include="..\MusicPlayer\Services\Localization.cs" Link="Shared\Services\Localization.cs" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <Compile Include="..\MusicPlayer\Models\*.cs" Link="Shared\Models\%(Filename)%(Extension)" />
    <Compile Include="..\MusicPlayer\Services\AudioTools.cs;..\MusicPlayer\Services\AudioError.cs;..\MusicPlayer\Services\ProcessRunner.cs;..\MusicPlayer\Services\Storage.cs;..\MusicPlayer\Services\UrlService.cs;..\MusicPlayer\Services\DownloadQueue.cs;..\MusicPlayer\Services\PlaybackOrder.cs" Link="Shared\Services\%(Filename)%(Extension)" />
    <Compile Include="..\MusicPlayer\Audio\AudioAnalyzer.cs;..\MusicPlayer\Audio\EqualizerSampleProvider.cs;..\MusicPlayer\Audio\EqualizerPresets.cs;..\MusicPlayer\Audio\VolumeCurve.cs;..\MusicPlayer\Audio\FfmpegSource.cs;..\MusicPlayer\Audio\ChapterSampleProvider.cs" Link="Shared\Audio\%(Filename)%(Extension)" />
    <Compile Include="..\MusicPlayer\Audio\TempoSampleProvider.cs;..\MusicPlayer\Audio\SoundEffectsProcessor.cs" Link="Shared\Audio\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\MusicPlayer\Assets\WaveDeck.png" Link="Assets\WaveDeck.png" />
    <Compile Include="..\MusicPlayer\Validation\MediaFixtureServer.cs" Link="Validation\MediaFixtureServer.cs" />
  </ItemGroup>
</Project>
