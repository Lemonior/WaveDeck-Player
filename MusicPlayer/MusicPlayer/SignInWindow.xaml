<Window x:Class="MusicPlayer.SignInWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WaveDeck — YouTube sign-in" Width="630" Height="485" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Icon="Assets/WaveDeck.png" Style="{StaticResource {x:Type Window}}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="CONNECT YOUR YOUTUBE ACCOUNT" Foreground="{DynamicResource Gold}" FontSize="17" FontWeight="Bold"/>
  <TextBlock Grid.Row="1" Text="Sign in to YouTube in your usual browser, then Connect.&#x0a;If your browser protects its session, choose either alternative below." TextWrapping="Wrap" Margin="0,14,0,0"/>
  <StackPanel Grid.Row="2" Margin="0,14,0,12"><WrapPanel><Button Content="Separate sign-in…" x:Name="SeparateButton" Click="Separate_Click" Margin="0,0,7,6"/><Button Content="Import session file…" x:Name="ImportButton" Click="Import_Click" Margin="0,0,7,6"/><Button Content="How to export" Click="ExportHelp_Click" Margin="0,0,0,6"/></WrapPanel><TextBlock Text="Separate sign-in opens a fresh window used only for WaveDeck. Finish signing in there and press Connect. If Google declines that window, export the current YouTube site's session with a browser exporter and import the .txt file here." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,10"/><TextBlock Text="Only Google / YouTube entries are kept, encrypted for your Windows user. Opening a web link alone does not connect the player. Imported files stay where you selected them; you can delete your export after connecting." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="SignInStatus" Text="Opening your default browser…" TextWrapping="Wrap" Foreground="{DynamicResource Gold}" Margin="0,12,0,0"/></StackPanel>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Open sign-in" Click="OpenSignIn_Click" Margin="0,0,7,0"/><Button Content="Cancel" IsCancel="True" Margin="0,0,7,0"/><Button x:Name="ConnectButton" Content="Connect to YouTube" Click="Connect_Click" Style="{StaticResource AccentButton}"/></StackPanel>
 </Grid>
</Window>
