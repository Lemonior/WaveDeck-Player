<Window x:Class="MusicPlayer.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:i18n="clr-namespace:MusicPlayer.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MusicPlayer.Controls" i18n:Translate.Title="WaveDeck — Settings" Width="660" Height="810" Style="{StaticResource {x:Type Window}}" ResizeMode="CanResize" MinWidth="620" MinHeight="600" WindowStartupLocation="CenterOwner" Icon="Assets/WaveDeck.png">
 <local:FantasyFrame IsOrnate="{DynamicResource FantasyDecorations}" Background="{DynamicResource SettingsSurface}" Margin="8"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock i18n:Translate.Text="MAKE IT YOUR DECK" Foreground="{DynamicResource Gold}" FontFamily="{DynamicResource HeaderFont}" FontWeight="Bold" FontSize="17"/><TextBlock TextWrapping="Wrap" i18n:Translate.Text="Appearance, downloads, playlists, and your YouTube account." Foreground="{DynamicResource Muted}" Margin="0,5,0,15"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,9,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock i18n:Translate.Text="THEME" Style="{StaticResource Label}"/><ComboBox x:Name="ThemeBox" Grid.Column="1" SelectionChanged="Theme_Changed"/></Grid>
   <TextBlock i18n:Translate.Text="Modern · slate / amber    OldSchool · dark stone / gold    Retro · violet / neon" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,6,0,16" TextWrapping="Wrap"/>
   <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock i18n:Translate.Text="LANGUAGE" Style="{StaticResource Label}"/><ComboBox x:Name="LanguageBox" Grid.Column="1"/></Grid>
   <TextBlock i18n:Translate.Text="Language changes apply when you save settings." FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,0,16" TextWrapping="Wrap"/>
   <TextBlock i18n:Translate.Text="DOWNLOAD FOLDER" Style="{StaticResource Label}" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderBox"/><Button Grid.Column="1" i18n:Translate.Content="Browse…" Click="Browse_Click" Margin="7,0,0,0"/></Grid>
   <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,7,0"><TextBlock i18n:Translate.Text="AUDIO FORMAT" Style="{StaticResource Label}" Margin="0,0,0,6"/><ComboBox x:Name="FormatBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock i18n:Translate.Text="LOSSY BITRATE" Style="{StaticResource Label}" Margin="0,0,0,6"/><ComboBox x:Name="QualityBox"/></StackPanel></Grid>
   <CheckBox x:Name="SplitChaptersCheck" i18n:Translate.Content="Save songs inside chaptered videos as separate audio files" Margin="0,12,0,5"/>
   <TextBlock i18n:Translate.Text="Uses the video's published chapter titles and timestamps. Videos without chapters download as one file." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"/>
   <CheckBox x:Name="PlaylistCheck" i18n:Translate.Content="Include the playlist when a video URL contains one" Margin="0,0,0,8"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock i18n:Translate.Text="Tracks per page" Foreground="{DynamicResource Muted}"/><TextBox Grid.Column="1" x:Name="LimitBox"/><TextBlock Grid.Column="2" i18n:Translate.Text="Total limit" Foreground="{DynamicResource Muted}" Margin="15,0,0,0"/><TextBox Grid.Column="3" x:Name="MaximumBox"/></Grid>
   <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock i18n:Translate.Text="Seconds between downloads (0–30)" Foreground="{DynamicResource Muted}"/><TextBox Grid.Column="1" x:Name="DelayBox"/></Grid>
   <CheckBox x:Name="RememberCheck" i18n:Translate.Content="Remember my playlist between sessions" Margin="0,12,0,16"/>
   <CheckBox x:Name="ResumeCheck" i18n:Translate.Content="Remember my last song and position (restore paused)" Margin="0,0,0,8"/>
   <CheckBox x:Name="ScanSiblingsCheck" i18n:Translate.Content="When opening audio, also add music from the same folder" Margin="0,0,0,8"/>
   <CheckBox x:Name="ScanSubfoldersCheck" i18n:Translate.Content="Include subfolders when scanning music folders" Margin="0,0,0,12"/>
   <Button i18n:Translate.Content="Choose default file types…" Click="Defaults_Click" HorizontalAlignment="Left" Margin="0,0,0,6"/>
   <TextBlock i18n:Translate.Text="Register WaveDeck for audio and playlists, then choose your file types in Windows. Adds a Play folder in WaveDeck action to Explorer." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,16"/>
   <TextBlock i18n:Translate.Text="APPLICATION UPDATES" Style="{StaticResource Label}" Margin="0,0,0,7"/>
   <TextBlock x:Name="AppVersionText" Foreground="{DynamicResource Muted}" Margin="0,0,0,7"/>
   <CheckBox x:Name="StartupUpdateCheck" i18n:Translate.Content="Check for updates when WaveDeck opens" Margin="0,0,0,8"/>
   <Button i18n:Translate.Content="Check Updates" Click="CheckUpdates_Click" HorizontalAlignment="Left" Margin="0,0,0,16"/>
   <TextBlock i18n:Translate.Text="YOUTUBE ACCOUNT" Style="{StaticResource Label}" Margin="0,0,0,7"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="AccountStatus" Foreground="{DynamicResource Muted}" FontSize="11"/><Button Grid.Column="1" i18n:Translate.Content="Sign in with Google" Click="SignIn_Click"/><Button Grid.Column="2" x:Name="DisconnectButton" i18n:Translate.Content="Disconnect" Click="Disconnect_Click" Margin="6,0,0,0"/></Grid>
   <TextBlock i18n:Translate.Text="Use your default browser, a separate sign-in window, or import a session file when your browser protects its login. Sessions are encrypted for this Windows user. Private and member videos still require access on your account." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,7,0,10"/>
   <CheckBox x:Name="HistoryCheck" i18n:Translate.Content="Add played YouTube videos to my account's watch history" Margin="0,0,0,4"/><TextBlock i18n:Translate.Text="Requires a connected account and enabled YouTube history. Requests run after playback begins; YouTube may reject them." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,0,16"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button i18n:Translate.Content="Update YouTube tool" Click="Update_Click"/><TextBlock Grid.Column="1" x:Name="UpdateStatus" i18n:Translate.Text="Bundled yt-dlp + FFmpeg + Deno" FontSize="10" Margin="12,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/></Grid>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button i18n:Translate.Content="Cancel" IsCancel="True" MinWidth="80" Margin="0,0,7,0"/><Button i18n:Translate.Content="Save settings" IsDefault="True" Click="Save_Click" Style="{StaticResource AccentButton}"/></StackPanel>
 </Grid></local:FantasyFrame>
</Window>
