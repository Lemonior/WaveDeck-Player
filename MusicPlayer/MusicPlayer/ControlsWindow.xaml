<Window x:Class="MusicPlayer.ControlsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MusicPlayer.Controls" Title="WaveDeck — Playback controls" Width="530" Height="475" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Icon="Assets/WaveDeck.png" Style="{StaticResource {x:Type Window}}">
 <local:FantasyFrame IsOrnate="{DynamicResource FantasyDecorations}" Background="{DynamicResource SettingsSurface}" Margin="8" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="PLAYBACK CONTROLS" Foreground="{DynamicResource Gold}" FontFamily="{DynamicResource HeaderFont}" FontWeight="Bold" FontSize="17" Margin="0,0,0,18"/>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions><TextBlock Text="Play / pause key"/><ComboBox x:Name="KeyChoice" Grid.Column="1"/></Grid>
  <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions><TextBlock Text="Play / pause mouse button"/><ComboBox x:Name="MouseChoice" Grid.Column="1"/></Grid>
  <StackPanel Grid.Row="3" Margin="0,16,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions><TextBlock Text="Background play / pause"/><ComboBox x:Name="GlobalChoice" Grid.Column="1"/></Grid><CheckBox x:Name="MediaKeysCheck" Content="Use hardware media keys while other apps are active" Margin="0,12,0,8"/><TextBlock Text="Background shortcuts work while WaveDeck is open or minimized. Hardware media keys include keyboard FN combinations and mouse buttons assigned to media commands.&#x0a;&#x0a;The key and mouse choices above work inside WaveDeck.&#x0a;Ctrl+Left / Right: seek 10 seconds&#x0a;Alt+Left / Right: previous / next track" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11"/></StackPanel>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Margin="0,0,7,0"/><Button Content="Save controls" IsDefault="True" Click="Save_Click" Style="{StaticResource AccentButton}"/></StackPanel>
 </Grid></local:FantasyFrame>
</Window>
